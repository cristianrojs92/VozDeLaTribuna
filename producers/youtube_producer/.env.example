# Variables de entorno para el script youtube_to_redis_producer.py

# (OBLIGATORIO) UUID único para identificar el evento (ej: un partido de fútbol específico)
# Ejemplo: a1b2c3d4-e5f6-7890-1234-567890abcdef
EVENT_UUID=test

# (OBLIGATORIO) ID del video de YouTube del cual se leerán los comentarios en vivo
# Ejemplo: dQw4w9WgXcQ
YOUTUBE_VIDEO_ID=yAnti2j5kmw

# Host del servidor Redis
REDIS_HOST=localhost

# Puerto del servidor Redis
REDIS_PORT=6379

# Nombre del Stream en Redis donde se publicarán los comentarios
REDIS_STREAM_NAME=comment_stream:live

# Intervalo en segundos para verificar nuevos comentarios (opcional, pytchat maneja su propio polling)
# Dejar vacío o comentado para usar el comportamiento por defecto de pytchat y un sleep mínimo.
# CAPTURE_INTERVAL_SECONDS=1 