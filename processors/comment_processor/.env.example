# Variables de entorno para el script comment_processor.py

# Host del servidor Redis
REDIS_HOST=localhost

# Puerto del servidor Redis
REDIS_PORT=6379

# Nombre del Stream en Redis del cual se consumirán los comentarios
REDIS_STREAM_NAME=comment_stream:live

# Nombre del grupo de consumidores para este procesador
# Cada instancia del procesador con el mismo grupo compartirá la carga
REDIS_CONSUMER_GROUP_NAME=comment_processing_group

# Nombre único para este consumidor dentro del grupo (ej. hostname, uuid, o un nombre descriptivo)
# Ayuda a identificar al consumidor en caso de necesitar recuperar mensajes pendientes
REDIS_CONSUMER_NAME=processor_instance_1

# Cuántos mensajes intentar leer del stream a la vez
# READ_COUNT=10

# Tiempo de bloqueo en milisegundos para esperar nuevos mensajes
# BLOCK_MILLISECONDS=2000 